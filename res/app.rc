#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_APP ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_RC
 PRODUCTVERSION VER_RC
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Taskbar System Info"
            VALUE "FileVersion", VER_STR
            VALUE "InternalName", "TaskbarSysInfo"
            VALUE "OriginalFilename", "TaskbarSysInfo.exe"
            VALUE "ProductName", "Taskbar System Info"
            VALUE "ProductVersion", VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
